{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/whatnick/whatnick-energy-monitor-skills/whatnick-energy-monitor-elecrow-ordering/references/audit-record.schema.json",
  "title": "PII-free Elecrow manufacturing audit record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checked_at",
    "live_verified",
    "supplier_reference",
    "project",
    "kind",
    "quantity",
    "stage",
    "costs",
    "artifacts",
    "release_holds",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "live_verified": {
      "type": "boolean"
    },
    "supplier_reference": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": ["bare-pcb", "pcba", "3d-print", "other"]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "stage": {
      "enum": [
        "quote",
        "payment",
        "production",
        "receive-and-qa",
        "complete",
        "canceled"
      ]
    },
    "supplier_status": {
      "type": ["string", "null"]
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency"],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "board": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "components": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "assembly": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "stencil": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "freight": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "tax": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "total": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "effective_unit": {
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "fabrication": {
      "type": "object",
      "description": "Non-sensitive configuration such as thickness, finish, mask, silkscreen and exact variant MPN."
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "filename", "sha256"],
        "properties": {
          "role": {
            "enum": ["gerber", "bom", "cpl", "instructions", "quote", "other"]
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        }
      }
    },
    "release_holds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "project_item_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Technical summary only; exclude names, contact, account, address, payment and signed URL data."
    }
  }
}
